# 数据库（Supabase PostgreSQL）
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 会话签名密钥（必填，生产环境务必设置）
# 生成方式：openssl rand -base64 48  或  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# 应用对外地址（用于回调等）
NEXT_PUBLIC_APP_URL="https://your-domain.com"
